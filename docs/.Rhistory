library(patchwork)
hist1 <-
ggplot(tidy_penguins, aes(x = body_mass_g, fill = species)) +
geom_histogram(position = "identity", alpha = 0.75)
hist2 <-
ggplot(tidy_penguins, aes(x = flipper_length_mm, fill = species)) +
geom_histogram(position = "identity", alpha = 0.75)
points1 <-
ggplot(tidy_penguins, aes(x = body_mass_g,
y = flipper_length_mm,
color = species)) +
geom_point(alpha = 0.75)
## Using patchwork syntax!
combined_plot <- (hist1 + hist2)/points1
combined_plot
